{
  "name": "greendex-monorepo",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "auth:generate": "turbo run auth:generate",
    "build": "turbo run build --concurrency=1",
    "check:agent-instructions": "tsx scripts/check-agent-instructions.ts && vitest run scripts/check-agent-instructions.policy.test.ts",
    "check:cost-tracker-persistence-seam": "tsx scripts/check-cost-tracker-persistence-seam.ts",
    "check:no-copy-assertions": "tsx scripts/check-no-copy-assertions.ts",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:reset": "tsx packages/database/src/tooling/reset-cli.ts",
    "db:seed": "pnpm --filter @greendex/calculator run db:seed",
    "db:studio": "turbo run db:studio",
    "dev": "turbo run dev",
    "format": "turbo run format && oxfmt scripts turbo.json tsconfig.json tsconfig.base.json vitest.config.mts package.json pnpm-workspace.yaml",
    "lint": "turbo run lint --concurrency 1 && pnpm run lint:design-system && pnpm run check:agent-instructions && pnpm run check:cost-tracker-persistence-seam && pnpm run check:no-copy-assertions",
    "lint:design-system": "pnpm --filter @greendex/calculator --filter @greendex/cost-tracker --filter @greendex/documentation run lint:design-system",
    "predev": "pnpm run db:migrate && dotenv -e apps/calculator/.env -- dotenv -e apps/documentation/.env -- dotenv -e apps/cost-tracker/.env -- node scripts/prepare-dev-ports.mjs",
    "prepare": "husky",
    "start": "turbo run start",
    "test:e2e": "tsx scripts/test.ts e2e",
    "test:full": "tsx scripts/test.ts full",
    "test:integration": "tsx scripts/test.ts integration",
    "test:unit": "tsx scripts/test.ts unit",
    "type-check": "turbo run type-check && pnpm run type-check:cost-tracker-persistence-seam",
    "type-check:cost-tracker-persistence-seam": "tsc --project scripts/tsconfig.json"
  },
  "dependencies": {
    "dotenv-cli": "catalog:",
    "turbo": "^2.11.10"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.2.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "husky": "^9.1.7",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2004",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2"
}
