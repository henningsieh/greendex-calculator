  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "intent": {
    "version": 1,
    "repo": "henningsieh/greendex-calculator",
    "docs": "https://github.com/henningsieh/greendex-calculator/blob/main/docs/agents/instructions/better-auth.md"
