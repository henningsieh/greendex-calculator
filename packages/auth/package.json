{
  "name": "@greendex/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./permissions": "./src/permissions.ts",
    "./project-authorization": "./src/project-authorization.ts",
    "./oauth-icons": "./src/oauth-icons.tsx",
