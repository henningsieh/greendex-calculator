{
  "name": "@greendex/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/*",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./locales/*.json": "./src/locales/*.json"
  },
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "test:run": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@greendex/config": "workspace:*"
  },
  "devDependencies": {
    "next": "catalog:",
    "next-intl": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "next-intl": "catalog:"
  }
}
