{
  "name": "@greendex/calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./env": "./src/env.ts",
    "./lib/i18n/types": "./src/lib/i18n/types.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development dotenv run -f .env -- concurrently --kill-others \"pnpm run dev:next\" \"pnpm run dev:socket\"",
    "dev:next": "next dev --port $PORT",
    "dev:socket": "tsx --watch src/socket-server.ts",
    "prebuild": "dotenv run -f .env -- pnpm run generate:sri && dotenv run -f .env -- pnpm run check:sri && dotenv run -f .env -- turbo run db:migrate",
    "build": "next build",
    "prestart": "dotenv run -f .env -- pnpm run start:prepare",
    "start:prepare": "pnpm dlx kill-port \"$PORT\" \"$SOCKET_PORT\" || true; sleep 1; pnpm --filter @greendex/database run db:migrate",
    "start": "NODE_ENV=production dotenv run -f .env -- pnpm run serve",
    "serve": "concurrently --kill-others \"next start --port $PORT\" \"tsx src/socket-server.ts\"",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "type-check": "next typegen && tsc --noEmit",
    "generate:sri": "node scripts/generate-sri.js",
    "check:sri": "node scripts/check-sri.js",
    "test": "pnpm run test:run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:interactive": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "HEADED=true playwright test --headed",
    "test:e2e:report": "pnpm dlx kill-port 9323 || true && pnpm exec playwright show-report src/__tests__/e2e/.playwright/report",
    "db:seed": "pnpm exec tsx scripts/seed.ts",
    "auth:generate": "dotenv run -f .env -- auth generate --config src/lib/better-auth/index.ts --output ../../packages/database/src/schemas/auth-schema.ts --yes",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@greendex/auth": "workspace:*",
    "@greendex/config": "workspace:*",
    "@greendex/database": "workspace:*",
    "@greendex/email": "workspace:*",
    "@greendex/i18n": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@orpc/client": "^1.15.4",
    "@orpc/openapi": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@orpc/tanstack-query": "^1.15.4",
    "@orpc/zod": "1.15.4",
