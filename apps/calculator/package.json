{
  "name": "@greendex/calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./env": "./src/env.ts",
    "./lib/i18n/types": "./src/lib/i18n/types.ts"
  },
  "scripts": {
    "auth:generate": "dotenv -e .env -- auth generate --config src/lib/better-auth/index.ts --output ../../packages/database/src/schemas/auth-schema.ts --yes",
    "build": "next build",
    "clean": "rm -rf .next .turbo node_modules",
    "db:seed": "pnpm exec tsx scripts/seed.ts",
    "dev": "dotenv -v NODE_ENV=development -e .env -- concurrently --kill-others \"pnpm run dev:next\" \"pnpm run dev:socket\"",
    "dev:next": "next dev --port $PORT",
    "dev:socket": "tsx --watch src/socket-server.ts",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "prebuild": "dotenv -e .env -- pnpm -w run db:migrate",
    "prestart": "dotenv -e .env -- pnpm run start:prepare",
    "serve": "concurrently --kill-others \"next start --port $PORT\" \"tsx src/socket-server.ts\"",
    "start": "dotenv -v NODE_ENV=production -e .env -- pnpm run serve",
    "start:prepare": "pnpm dlx kill-port \"$PORT\" \"$SOCKET_PORT\" || true; sleep 1; pnpm --filter @greendex/database run db:migrate",
    "test": "pnpm run test:run && pnpm run test:e2e",
    "test:coverage": "vitest --coverage",
    "test:e2e": "dotenv -e .env -- playwright test",
    "test:e2e:debug": "dotenv -e .env -- playwright test --debug",
    "test:e2e:headed": "dotenv -v HEADED=true -e .env -- playwright test --headed",
    "test:e2e:report": "pnpm dlx kill-port 9323 || true && pnpm exec playwright show-report src/__tests__/e2e/.playwright/report",
    "test:e2e:ui": "dotenv -e .env -- playwright test --ui",
    "test:interactive": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@greendex/auth": "workspace:*",
    "@greendex/config": "workspace:*",
    "@greendex/database": "workspace:*",
    "@greendex/email": "workspace:*",
    "@greendex/i18n": "workspace:*",
