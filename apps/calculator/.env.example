# Editor Configuration
REACT_EDITOR=code-insiders | code | cursor

# Calculator application
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NODE_ENV=development
PORT=3000
SOCKET_PORT=4000
ORPC_DEV_DELAY_MS=300

# Database: configure DATABASE_URL once in ../../packages/database/.env.
# Both applications load the shared connection before their app-local values.

# Better Auth (OAuth providers — create apps in each provider console)
LOCAL_E2E_AUTH=0 # Set to 1 only for local E2E: login limit 30/10s; loopback base URL required.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Nodemailer SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=

# Dedicated live-email verification mailbox (never use unrelated recipients)
IMAP_HOST=mail.sieh.org
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=greendex-testing@apps.sieh.org
IMAP_PASSWORD=
EMAIL_TEST_SENDER=greendex-testing@apps.sieh.org
EMAIL_TEST_RECIPIENT=greendex-testing@apps.sieh.org
# Retain test messages unless explicitly opting into run-only deletion.
DELETE_TESTMAILS_DURING_TESTRUN=false
