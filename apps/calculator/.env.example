# Editor Configuration
REACT_EDITOR=code-insiders | code | cursor

# Calculator application
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NODE_ENV=development
PORT=3000
SOCKET_PORT=4000
ORPC_DEV_DELAY_MS=300

# Database — one dedicated database per app checkout. This Calculator uses the
# Shared development database — both apps use calculator_dev on :5445 so
# cost-tracker sees the same seeded rows as calculator (see
docs/database/development-databases.md). Retrieve the password from Coolify;
# never commit credentials.
DATABASE_URL=postgres://user:password@host:port/database

# Better Auth (OAuth providers — create apps in each provider console)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Nodemailer SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=
