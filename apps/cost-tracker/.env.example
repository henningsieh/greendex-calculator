# Cost Tracker application
COST_TRACKER_PORT=3002

# Database and Better Auth
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Better Auth Google OAuth
# Use the dedicated Google Cloud application for Cost Tracker login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (same SMTP settings used by Calculator)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=

# IMAP (used only by the self-cleaning verification-email test)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USERNAME=
IMAP_PASSWORD=
EMAIL_TEST_SENDER=
EMAIL_TEST_RECIPIENT=

# Garage S3 (server-only; never prefix secrets with NEXT_PUBLIC_)
S3_ENDPOINT=https://s3-garage.apps.sieh.org
S3_REGION=garage
S3_BUCKET=ambitia-cost-tracker-development
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
