{
  "name": "@greendex/cost-tracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rm -rf .next .turbo node_modules",
    "db:seed": "dotenv -e ../../packages/database/.env -e .env -- pnpm exec tsx ../calculator/scripts/seed.ts",
    "dev": "env -u DATABASE_URL dotenv -v NODE_ENV=development -e ../../packages/database/.env -e .env -- sh -c 'next dev --port \"$COST_TRACKER_PORT\"'",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "lint:design-system": "oxlint -A all -D shadcn/no-restyle src",
    "prestart": "dotenv -e ../../packages/database/.env -e .env -- pnpm run start:prepare",
    "start": "dotenv -v NODE_ENV=production -e ../../packages/database/.env -e .env -- sh -c 'next start --port \"$COST_TRACKER_PORT\"'",
    "start:prepare": "pnpm dlx kill-port \"$COST_TRACKER_PORT\" || true; sleep 1; pnpm --filter @greendex/database run db:migrate",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@base-ui/react": "^1.9.0",
    "@greendex/auth": "workspace:*",
    "@greendex/config": "workspace:*",
    "@greendex/database": "workspace:*",
    "@greendex/email": "workspace:*",
    "@greendex/i18n": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@orpc/zod": "catalog:",
    "@t3-oss/env-nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "dotenv-cli": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-themes": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "catalog:",
    "react-hook-form": "catalog:",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "imapflow": "^2.9.0",
    "jsdom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "pg": "catalog:",
    "postal-mime": "^4.1.4",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.22.0"
  }
}
