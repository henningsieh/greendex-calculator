{
  "name": "@greendex/cost-tracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -v NODE_ENV=development -e .env -- sh -c 'next dev --port \"$COST_TRACKER_PORT\"'",
    "build": "next build",
    "start": "dotenv -v NODE_ENV=production -e .env -- sh -c 'next start --port \"$COST_TRACKER_PORT\"'",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf .next .turbo node_modules",
    "test:email-delivery": "dotenv -e .env -- tsx scripts/verify-email-delivery.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@greendex/auth": "workspace:*",
    "@greendex/database": "workspace:*",
    "@greendex/email": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@orpc/tanstack-query": "^1.15.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "1.41.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.5",
    "react-hook-form": "^7.87.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "imapflow": "^1.7.8",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
