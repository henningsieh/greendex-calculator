# Realtime notifications service: local and container values.
# Browser-facing origin for the Socket.IO client.
REALTIME_PUBLIC_URL=http://localhost:4001
# Internal listener. Use 127.0.0.1 locally and 0.0.0.0 in a container.
REALTIME_PORT=4001
REALTIME_BIND_HOST=127.0.0.1
# Only this Cost Tracker origin may open a Socket.IO connection.
COST_TRACKER_PUBLIC_URL=http://localhost:3002
# Used to validate Better Auth session cookies on handshake.
COST_TRACKER_INTERNAL_URL=http://localhost:3002
# Shared with apps/cost-tracker/.env; at least 16 characters.
REALTIME_EMIT_SECRET=
