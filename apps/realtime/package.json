{
  "name": "@greendex/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .turbo",
    "dev": "dotenv -e .env -- tsx --watch src/server.ts",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "start": "tsx src/server.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@greendex/notifications": "workspace:*",
    "dotenv-cli": "catalog:",
    "socket.io": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "socket.io-client": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
