{
  "name": "@greendex/documentation",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "clean": "rm -rf .next .turbo node_modules",
    "dev": "dotenv -v NODE_ENV=development -e .env -- sh -c 'next dev --port \"$DOCUMENTATION_PORT\"'",
    "format": "oxfmt",
    "lint": "oxlint --fix --fix-suggestions --fix-dangerously",
    "postinstall": "fumadocs-mdx",
    "predev": "dotenv -e .env -- sh -c 'fuser -k \"$DOCUMENTATION_PORT/tcp\" || true'",
    "start": "dotenv -v NODE_ENV=production -e .env -- sh -c 'next start --port \"$DOCUMENTATION_PORT\"'",
    "type-check": "fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@greendex/config": "workspace:*",
    "@greendex/i18n": "workspace:*",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "country-flag-icons": "catalog:",
    "dotenv-cli": "catalog:",
    "fumadocs-core": "16.15.17",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-ui": "16.15.17",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.28",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  }
}
