{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "options": {
    "typeAware": true
  },
  "ignorePatterns": [
    "node_modules/**",
    ".next/**",
    "dist/**",
    "build/**",
    "docs/**",
    "specs/**",
    "src/components/ui/**",
    "src/lib/drizzle/migrations/**",
    "src/lib/drizzle/schemas/**"
  ],
  "rules": {
    "import/no-relative-parent-imports": "error",
    "typescript/no-deprecated": [
      "error",
      {
        "allow": [
          "requestLocale",
          {
            "from": "package",
            "package": "next-intl",
            "name": "setRequestLocale"
          }
        ]
      }
    ],
    "complexity": ["warn", 25],
    "curly": "off",
    "react/no-array-index-key": "off",
    "typescript/array-type": "warn",
    "typescript/no-misused-spread": "off",
    "typescript/no-base-to-string": "off",
    "typescript/restrict-template-expressions": "off",
    "no-unsafe-optional-chaining": "off",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          { "pattern": "^Card$", "allow": ["layout", "spacing"] },
          {
            "pattern": "^CardTitle$",
            "allow": ["layout", "spacing", "typography"]
          },
          {
            "pattern": "^CardContent$",
            "allow": ["layout", "spacing", "typography"]
          },
          { "pattern": "^CardHeader$", "allow": ["layout", "spacing"] },
          { "pattern": "^CardFooter$", "allow": ["layout", "spacing"] },
          {
            "pattern": "^CardDescription$",
            "allow": ["layout", "spacing", "typography"]
          },
          { "pattern": "^Label$", "allow": ["layout", "typography"] },
          { "pattern": "^Input$", "allow": ["layout", "typography"] },
          {
            "pattern": "^CountrySelect$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^Skeleton$",
            "allow": ["layout", "spacing", "color", "shape"]
          },
          { "pattern": "^FieldGroup$", "allow": ["layout", "spacing"] },
          { "pattern": "^FieldSet$", "allow": ["layout", "spacing"] },
          {
            "pattern": "^FieldDescription$",
            "allow": ["layout", "spacing", "typography"]
          },
          { "pattern": "^Tabs$", "allow": ["layout", "spacing"] },
          { "pattern": "^TabsList$", "allow": ["layout", "spacing"] },
          { "pattern": "^TabsContent$", "allow": ["layout", "spacing"] },
          {
            "pattern": "^PopoverContent$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^DropdownMenuLabel$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^FieldSeparator$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^DropdownMenuContent$",
            "allow": ["layout", "spacing"]
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "apps/calculator/src/components/ui/**",
        "apps/documentation/src/components/ui/**"
      ],
      "rules": { "shadcn/no-restyle": "off" }
    },
    {
      "files": ["apps/calculator/src/features/landingpage/**"],
      "rules": { "shadcn/no-restyle": "off" }
    }
  ]
}
