#!/usr/bin/env sh
set -eu

# Default: check only files in this commit. Use PRE_COMMIT_FULL=1 for the
# repository-wide checks. Never bypass this hook with HUSKY=0 or
# git commit --no-verify: fix the failure instead and re-run the commit.
if [ "${PRE_COMMIT_FULL:-0}" = "1" ]; then
  pnpm run format
  pnpm run lint
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# Format and lint the staged snapshot only, and never mix unstaged work into
# the commit. Two paths per staged file, chosen by whether the file also has
# unstaged edits:
#
#   staged only -> oxfmt rewrites the file in place and the file is re-staged,
#                  so the commit and the working tree agree.
#   mixed       -> oxfmt formats the staged blob through stdin (same config,
#                  same ignore patterns, same Tailwind sorting) and the result
#                  is written straight into the index. The working tree is
#                  left untouched, so unstaged edits cannot leak into the
#                  commit and nothing needs stashing or `git add` of the file.
#
# Partial staging is normal workflow, so a mixed tree is not a failure. The
# invariant is narrower and absolute: the commit contains the staged snapshot,
# no more.
format_staged() {
  staged_format=$(git diff --cached --name-only --diff-filter=ACMR \
    | grep -E '\.(cjs|cts|css|json|jsonc|js|jsx|md|mdx|mjs|mts|ts|tsx|yaml|yml)$' \
    | grep -vE '^(docs/|\.specify/|specs/)' \
    || true)
  [ -n "$staged_format" ] || return 0

  while IFS= read -r path; do
    [ -n "$path" ] || continue

    # Only regular files carry a blob the formatter may rewrite. Symlinks and
    # submodule entries keep their entry untouched.
    entry=$(git ls-files -s -- "$path")
    mode=${entry%% *}
    case "$mode" in
      100644 | 100755) ;;
      *) continue ;;
    esac

    if git diff --quiet -- "$path"; then
      # No unstaged edits: format in place and re-stage that one file.
      pnpm exec oxfmt --write --no-error-on-unmatched-pattern -- "$path" || exit 1
      git add -- "$path"
      continue
    fi

    # Mixed tree: format the staged blob and update only the index entry.
    blob_in=$(mktemp) || exit 1
    blob_out=$(mktemp) || exit 1
    if ! git show ":$path" > "$blob_in"; then
      rm -f "$blob_in" "$blob_out"
      echo "husky: could not read the staged version of $path" >&2
      exit 1
    fi
    if ! pnpm exec oxfmt --stdin-filepath="$path" < "$blob_in" > "$blob_out"; then
      rm -f "$blob_in" "$blob_out"
      echo "husky: could not format the staged version of $path" >&2
      exit 1
    fi
    if ! cmp -s "$blob_in" "$blob_out"; then
      formatted=$(git hash-object -w --path="$path" "$blob_out") || {
        rm -f "$blob_in" "$blob_out"
        exit 1
      }
      git update-index --cacheinfo "$mode,$formatted,$path" || {
        rm -f "$blob_in" "$blob_out"
        exit 1
      }
      echo "husky: formatted the staged version of $path (unstaged edits kept)"
    fi
    rm -f "$blob_in" "$blob_out"
  done <<EOF
$staged_format
EOF
}

format_staged

# Lint every staged script file. Same selection idea, narrower file types:
# only code reaches the linter, docs never do.
# When every selected file is ignore-listed, oxlint reports "No files found to
# lint" and exits nonzero — nothing to do is a pass, not a failure. Classify
# the reported lines instead of comparing the whole output to one string:
# oxlint wraps that message in its own run summary ("Finished in …"), so an
# exact comparison fails commits that touch only ignore-listed files. Anything
# that is not an ignorable line is a real finding and fails the commit.
lint_out=$(git diff --cached --name-only -z --diff-filter=ACMR \
  | grep -zE '\.(cjs|cts|js|jsx|mjs|mts|ts|tsx)$' \
  | xargs -0 -r pnpm exec oxlint --config .oxlintrc.json 2>&1) || {
  lint_findings=$(printf '%s\n' "$lint_out" \
    | grep -vE '^(No files found to lint\.|Finished in .*)$' || true)
  if [ -n "$lint_findings" ]; then
    printf '%s\n' "$lint_out" >&2
    exit 1
  fi
}
[ -n "$lint_out" ] && printf '%s\n' "$lint_out"

# Keep agent-context quality high: the drift guard and its policy tests are
# build-free reads (node + single-file vitest, ~seconds) and block the commit
# on drift. Never bypass with --no-verify; fix the drift instead.
pnpm run check:agent-instructions

# Tests must never assert visible copy: rewording or translation must not
# break suites. This scan is a build-free read (~1s) over test sources and
# blocks the commit on violation. Never bypass with --no-verify;
# reword the test instead.
# Scoped to staged test sources: WIP violations in untouched files must not
# block unrelated commits. CI runs the full scan as the backstop.
staged_tests=$(git diff --cached --name-only -z --diff-filter=ACMR \
  | grep -zE '(^apps/[^/]+/(src/__tests__/(e2e|merge)/|test/e2e/)|\.(test|spec)\.(ts|tsx|js|jsx|mts|cts)$)' \
  || true)
if [ -n "$staged_tests" ]; then
  pnpm run check:no-copy-assertions
else
  echo 'husky: no staged test sources — skipping check:no-copy-assertions (CI still runs it).'
fi
